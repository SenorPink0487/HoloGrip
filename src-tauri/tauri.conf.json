{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HoloGrip",
  "version": "0.2.1",
  "identifier": "com.hologrip.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3002",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HoloGrip",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "HoloGrip",
    "homepage": "https://hologrip.com",
    "copyright": "© 2026 HoloGrip. All rights reserved.",
    "shortDescription": "HoloMath 沉浸式数学探索工作台",
    "longDescription": "HoloMath 让数学走进三维空间。通过自然手势、空间计算器与 AI 助教，把抽象公式变成可触可感的几何与动效，适用于课堂演示、自学与小组研究。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "nsis/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "installMode": "perMachine",
        "customLanguageFiles": {
          "SimpChinese": "nsis/SimpChinese.nsh"
        }
      }
    }
  }
}
