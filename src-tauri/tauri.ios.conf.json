{
  "productName": "HoloGrip",
  "identifier": "com.hologrip.app",
  "build": {
    "devUrl": "http://localhost:3002",
    "beforeDevCommand": "npm run dev:ipad",
    "beforeBuildCommand": "VITE_API_ORIGIN=https://hologrip.cn npm run build:ipad"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HoloGrip",
        "url": "whiteboard.html",
        "fullscreen": true,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "iOS": {
      "bundleVersion": "4",
      "developmentTeam": "25BK95MGBC",
      "minimumSystemVersion": "14.0"
    }
  }
}
