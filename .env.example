# ─────────────────────────────────────────────────────────────
# 前端环境变量(VITE_* 会被打进 bundle,部署时注意区分场景)
# ─────────────────────────────────────────────────────────────
#
# 模式选择由 VITE_GEMINI_BASE_URL 决定:
#   - 绝对地址 (https://...) → 直连模式,前端必须带 API_KEY,适合本地/桌面端
#   - 相对路径 (/api/gemini) → 反代模式,API_KEY 仅占位,真实 key 在服务端
#
# 本文件用于本地开发(直连模式),生产部署见 .env.production.example。

VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_BASE_URL="https://api.gemai.cc"
VITE_GEMINI_MODEL="[福利]gemini-3.5-flash"

# Tauri 桌面端用同一组配置(不带 VITE_ 前缀,保留待用)
GEMAI_API_KEY="MY_GEMINI_API_KEY"
GEMAI_BASE_URL="https://api.gemai.cc"
GEMAI_MODEL="[福利]gemini-3.5-flash"

# ── HoloChem（日常用语 → 分子成分；仅 Vite dev/preview 服务端读取，不进前端 bundle）──
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
