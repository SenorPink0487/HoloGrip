# Frontend/Vite environment variables.
# Copy this file to .env.local for local development.
# Backend secrets belong in server/.env (see server/.env.example).

# Direct Gemini mode (the key is embedded into the frontend bundle).
VITE_GEMINI_API_KEY=
VITE_GEMINI_BASE_URL=https://api.gemai.cc
VITE_GEMINI_MODEL=gemini-3.7-flash

# Tauri/native AI configuration.
GEMAI_API_KEY=
GEMAI_BASE_URL=https://api.gemai.cc
GEMAI_MODEL=gemini-3.7-flash

# Used by the chemistry frontend tooling when enabled.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
