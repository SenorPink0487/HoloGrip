# ============================================================
# HoloGrip 反代服务配置
# 部署时复制为 .env(同目录)。.env 不要提交到 Git。
# ============================================================

# ── 监听 / 上游 ─────────────────────────────────────────────
# 强烈建议保持 127.0.0.1,只让 Nginx 反代到这里。
PROXY_BIND=127.0.0.1:8787

# 上游 Gemini 网关地址,不带末尾斜杠
UPSTREAM_BASE_URL=https://api.gemai.cc

# 真实 API Key(放在服务端,前端永远拿不到)
UPSTREAM_API_KEY=sk-替换成你自己的key

# 上游请求超时(秒)
UPSTREAM_TIMEOUT_SECS=120

# ── Token 鉴权(关键)─────────────────────────────────────
# HMAC-SHA256 签名密钥,至少 32 字节。生成方法:
#   openssl rand -hex 32
AUTH_HMAC_SECRET=请用-openssl-rand-hex-32-生成-至少-32-字节

# 单 token 总调用次数(超过即拒,前端会自动重签)
AUTH_TOKEN_QUOTA=100

# token 生命周期(秒),默认 1 小时
AUTH_TOKEN_TTL_SECS=3600

# 允许签发 token 的 Origin 白名单。多个用逗号,* 关闭校验。
# 例:AUTH_ISSUE_ALLOWED_ORIGINS=https://holo.example.com
AUTH_ISSUE_ALLOWED_ORIGINS=*

# ── CORS / 限制 ────────────────────────────────────────────
# 浏览器 CORS 白名单。同域部署时其实可以填 *。
# 例:CORS_ALLOWED_ORIGINS=https://holo.example.com
CORS_ALLOWED_ORIGINS=*

# 单 IP 频次限制
RATE_LIMIT_PER_SECOND=2
RATE_LIMIT_BURST=10

# 单次请求体最大字节数(图片 base64 偏大,默认 16MB)
MAX_BODY_BYTES=16777216

# ── Metrics ────────────────────────────────────────────────
# Prometheus 抓取端点,只在 127.0.0.1 暴露。空字符串关闭。
METRICS_BIND=127.0.0.1:9898

# ── 日志 ───────────────────────────────────────────────────
RUST_LOG=hologrip_proxy=info,tower_http=info
