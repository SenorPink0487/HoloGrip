# ============================================================
# HoloGrip 反代服务配置
# 部署时复制为 .env（同目录）。.env 不要提交到 Git。
# ============================================================

# ── 监听 / 上游 ─────────────────────────────────────────────
PROXY_BIND=127.0.0.1:8787

# 上游 Gemini 网关地址，不带末尾斜杠
UPSTREAM_BASE_URL=https://api.gemai.cc

# 真实 API Key（放在服务端，前端永远拿不到）
UPSTREAM_API_KEY=sk-替换成你自己的key

# 上游请求超时（秒）
UPSTREAM_TIMEOUT_SECS=120

# ── HoloChem AI 解析 ───────────────────────────────────────
# 留空时，只有 /api/resolve-molecule 和 /api/resolve-reaction 不可用。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 数据库 ────────────────────────────────────────────────
# MySQL 连接串，格式：mysql://用户名:密码@host:端口/库名
DATABASE_URL=mysql://hologrip:你的密码@127.0.0.1:3306/hologrip_db

# ── 用户 JWT ─────────────────────────────────────────────
# HMAC-SHA256 签名密钥，至少 32 字节。生成方法：
#   openssl rand -hex 32
JWT_SECRET=请用-openssl-rand-hex-32-生成-至少-32-字节

# JWT 有效期（秒），默认 7 天
JWT_EXPIRES_SECS=604800

# ── 修改密码邮箱验证码 ─────────────────────────────────────
# SMTP 发信配置。QQ/163 等邮箱通常需要使用“授权码”作为 SMTP_PASSWORD。
# SMTP_TLS=true 会在 587 等端口使用 STARTTLS；465 端口使用隐式 TLS。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=替换成-SMTP-密码或授权码
SMTP_FROM=HoloGrip <no-reply@example.com>
SMTP_TLS=true
APP_PUBLIC_BASE_URL=https://你的域名

# 首个管理员一次性邀请码。启动时写入数据库,用完即失效;留空则不创建。
ADMIN_BOOTSTRAP_INVITE_CODE=

# ── Token 鉴权（关键）─────────────────────────────────────
AUTH_HMAC_SECRET=请用-openssl-rand-hex-32-生成-至少-32-字节
AUTH_TOKEN_QUOTA=100
AUTH_TOKEN_TTL_SECS=3600
AUTH_ISSUE_ALLOWED_ORIGINS=*

# ── CORS / 限制 ────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_PER_SECOND=2
RATE_LIMIT_BURST=10
MAX_BODY_BYTES=16777216

# ── Metrics ────────────────────────────────────────────────
METRICS_BIND=127.0.0.1:9898

# ── 日志 ───────────────────────────────────────────────────
RUST_LOG=hologrip_proxy=info,tower_http=info
