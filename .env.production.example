# ─────────────────────────────────────────────────────────────
# 生产构建专用(部署到阿里云的 Web 版)
# 用法:在本地构建前临时 `cp .env.production.example .env`,然后 `npm run build`
# 构建出的 dist 里 VITE_GEMINI_API_KEY 是占位符,真实 key 在服务器 server/.env 里。
# ─────────────────────────────────────────────────────────────

# 反代相对路径,前端会发到同域的 /api/gemini/*,Nginx 转给 Rust 反代服务
VITE_GEMINI_BASE_URL="/api/gemini"

# Tauri 桌面构建使用同一台 Web 服务器的反代入口；网页构建无需设置。
VITE_API_ORIGIN="https://hologrip.cn"

# 反代模式下这个值不会被使用,但前端代码里保留了字段,给个占位符防止 import.meta.env 缺失
VITE_GEMINI_API_KEY="proxied-by-server"

VITE_GEMINI_MODEL="[福利]gemini-3.5-flash"
