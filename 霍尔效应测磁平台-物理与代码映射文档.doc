  </math>
</div>

<div class="file-loc">代码位置：src/physics/hall_magnetometer/components/Experiment3D.tsx -> getBFieldOffset 函数 (第 765 行至第 779 行)</div>
<pre>
function getBFieldOffset(x: number, yPrime: number, cx: number, R: number) {
   let bx = 0;
   let by = 0;
   const N = 32; // 将圆环均分为32份微元
   const dTheta = 2 * Math.PI / N;
   
   for (let i = 0; i &lt; N; i++) {
       const theta = i * dTheta;
       const cosT = Math.cos(theta);
       // 计算场点到电流微元源点的三维距离平方 D
       const D = Math.pow(x - cx, 2) + Math.pow(yPrime, 2) + Math.pow(R, 2) - 2 * R * yPrime * cosT;
       const D15 = Math.pow(Math.max(D, 0.01), 1.5); // 防止距离过近产生数值奇点
       
       // 微元法积分累加
       bx += (R * R - R * yPrime * cosT) / D15 * dTheta;
       by += (R * cosT * (x - cx)) / D15 * dTheta;
   }
   return { bx, by };
}
</pre>

<h3>4.2 亥姆霍兹线圈的场叠加</h3>
<p>利用磁场的<b>叠加原理</b>，亥姆霍兹线圈的整体磁场由左侧固定线圈（中心 <math xmlns="http://www.w3.org/1998/Math/MathML"><mi>x</mi><mo>=</mo><mo>&minus;</mo><mn>2.5</mn></math>, 半径 <math xmlns="http://www.w3.org/1998/Math/MathML"><mi>R</mi><mo>=</mo><mn>2.9</mn></math>）和右侧滑动线圈（中心 <math xmlns="http://www.w3.org/1998/Math/MathML"><mi>x</mi><mo>=</mo><mi>rightCoilPos</mi></math>）各自激发的空间磁场进行向量加和：</p>
<div class="file-loc">代码位置：src/physics/hall_magnetometer/components/Experiment3D.tsx -> getTotalBField 函数 (第 781 行至第 787 行)</div>
<pre>
function getTotalBField(x: number, y: number, rightCoilPos: number) {
    const yPrime = y - 4.5; // 坐标系偏置平移
    const R = 2.9;
    const { bx: bx1, by: by1 } = getBFieldOffset(x, yPrime, -2.5, R);
    const { bx: bx2, by: by2 } = getBFieldOffset(x, yPrime, rightCoilPos, R);
    return { bx: bx1 + bx2, by: by1 + by2 }; // 向量叠加
}
</pre>

<h3>4.3 螺线管的多线圈离散微元近似</h3>
<p>在 3D 物理线模拟中，代码采用<b>等效多圆环法</b>，将整个螺线管离散近似为 27 组等间距分布在 <math xmlns="http://www.w3.org/1998/Math/MathML"><mi>x</mi><mo>&isin;</mo><mo stretchy="false">[</mo><mo>&minus;</mo><mn>13</mn><mo>,</mo><mn>13</mn><mo stretchy="false">]</mo></math> 的独立载流圆环。通过循环调用圆环磁场函数计算合成磁场：</p>
<div class="file-loc">代码位置：src/physics/hall_magnetometer/components/Experiment3D.tsx -> getSolenoidBFieldTotal 函数 (第 874 行至第 886 行)</div>
<pre>
function getSolenoidBFieldTotal(x: number, y: number) {
    const yPrime = y - 3.65;
    const R = 1.4;
    let bx = 0;
    let by = 0;
    // 将30cm长的螺线管离散为27个等效圆环线圈进行磁场积分
    for (let cx = -13; cx &lt;= 13.01; cx += 1.0) {
        const { bx: bxi, by: byi } = getBFieldOffset(x, yPrime, cx, R);
        bx += bxi;
        by += byi;
    }
    return { bx, by };
}
</pre>

<h2>5. 磁感线数值流线追踪算法</h2>
<p>为了渲染出随电流方向流动的动态光效磁感线，代码中实现了一套<b>一阶常微分方程的欧拉积分追踪器（Streamline Tracing）</b>。</p>

<h3>5.1 追踪物理数学原理</h3>
<p>磁感线上任意一点的切线方向与该点的磁感应强度 <math xmlns="http://www.w3.org/1998/Math/MathML"><mover><mi>B</mi><mo>&rarr;</mo></mover></math> 方向一致。即满足常微分方程：</p>
<div class="formula-container">
  <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
    <mi>d</mi>
    <mover>
      <mi>r</mi>
      <mo>&rarr;</mo>
    </mover>
    <mo>=</mo>
    <mo>&plusmn;</mo>
    <mfrac>
      <mover>
        <mi>B</mi>
        <mo>&rarr;</mo>
      </mover>
      <mrow>
        <mo stretchy="false">|</mo>
        <mover>
          <mi>B</mi>
          <mo>&rarr;</mo>
        </mover>
        <mo stretchy="false">|</mo>
      </mrow>
    </mfrac>
    <mo>&middot;</mo>
    <mi>d</mi>
    <mi>s</mi>
  </math>
</div>
<p>给定一个起始“种子点”（Seed Point），顺着磁场方向以固定步长 <math xmlns="http://www.w3.org/1998/Math/MathML"><mi>&Delta;</mi><mi>s</mi></math> 逐步累加，可以描绘出一条磁感线（Forward Tracing）；逆着磁场方向以 <math xmlns="http://www.w3.org/1998/Math/MathML"><mo>&minus;</mo><mi>&Delta;</mi><mi>s</mi></math> 迭代，可描绘出另一侧（Backward Tracing），将二者拼接即可生成完整的闭合或半闭合磁流线。</p>

<h3>5.2 欧拉追踪的代码实现</h3>
<div class="file-loc">代码位置：src/physics/hall_magnetometer/components/Experiment3D.tsx -> MagneticFieldLinesSolenoid 组件内的 traceLine 函数 (第 894 行至第 920 行)</div>
<pre>
const traceLine = (startX: number, startY: number) => {
    const forward: THREE.Vector3[] = [];
    const backward: THREE.Vector3[] = [];
    const stepSize = 0.2; // 空间步长 ds
    const maxSteps = 250; // 最大迭代步数限制
    
    // 1. 顺着磁场方向正向积分 (Forward)
    let cx = startX, cy = startY;
    for(let i = 0; i &lt; maxSteps; i++) {
        forward.push(new THREE.Vector3(cx, cy, -8.5));
        const { bx, by } = getSolenoidBFieldTotal(cx, cy); // 算当前点磁场矢量
        const mag = Math.sqrt(bx*bx + by*by); // 求模长
        if (mag &lt; 1e-6) break; // 避开零场区或无限远处
        
        cx += (bx / mag) * stepSize; // x(t+dt) = x(t) + (Bx/|B|)*ds
        cy += (by / mag) * stepSize; // y(t+dt) = y(t) + (By/|B|)*ds
        if (cx &lt; -20 || cx &gt; 20 || cy &lt; -5 || cy &gt; 15) break; // 边界截断
    }

    // 2. 逆着磁场方向反向积分 (Backward)
    cx = startX; cy = startY;
    for(let i = 0; i &lt; maxSteps; i++) {
        if (i &gt; 0) backward.push(new THREE.Vector3(cx, cy, -8.5));
        const { bx, by } = getSolenoidBFieldTotal(cx, cy);
        const mag = Math.sqrt(bx*bx + by*by);
        if (mag &lt; 1e-6) break;
        
        cx -= (bx / mag) * stepSize; // x(t-dt) = x(t) - (Bx/|B|)*ds
        cy -= (by / mag) * stepSize; 
        if (cx &lt; -20 || cx &gt; 20 || cy &lt; -5 || cy &gt; 15) break;
    }
    
    return [...backward.reverse(), ...forward]; // 合并拼接为完整三维几何曲线线段
};
</pre>
<p>对于亥姆霍兹线圈，同样的流线追踪实现于 <code>MagneticFieldLines</code> 组件中的 <code>traceLine</code> 函数（第 819 行至第 845 行），唯一区别是调用 <code>getTotalBField(cx, cy, rightCoilPos)</code> 并将坐标映射至平面 $Z = -2.0$。</p>

<h3>5.3 动画模拟与励磁映射</h3>
<p>在渲染帧循环中，通过持续减小虚线材质的 <code>dashOffset</code> 来模拟磁流线随电流的运动：</p>
<div class="file-loc">代码位置：src/physics/hall_magnetometer/components/Experiment3D.tsx -> FlowingLine 组件 (第 789 行至第 811 行)</div>
<pre>
useFrame((_, delta) => {
    if (ref.current && ref.current.material) {
        // dashOffset 变化速度乘以电流方向 dir (正向流入或反向流出)
        ref.current.material.dashOffset -= delta * 3.0 * dir; 
    }
});
</pre>
<p>虚线不透明度与励磁电流映射：不透明度设为 <code>opacity={Math.min(1.0, Im * 1.5) * 0.7}</code>，当电流为 <math xmlns="http://www.w3.org/1998/Math/MathML"><mn>0</mn></math> 时线完全消失，电流大时线条明亮，实时响应调节。</p>

<h2>6. 霍尔效应与电压仿真模型</h2>
<h3>6.1 霍尔效应基本方程</h3>
<p>在恒定控制工作电流 <math xmlns="http://www.w3.org/1998/Math/MathML"><msub><mi>I</mi><mi>s</mi></msub></math> 下，霍尔片输出的霍尔电压 <math xmlns="http://www.w3.org/1998/Math/MathML"><msub><mi>V</mi><mi>H</mi></msub></math> 满足：</p>
<div class="formula-container">
  <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
    <msub>
      <mi>V</mi>
      <mi>H</mi>
    </msub>
    <mo>=</mo>
    <mi>K</mi>
    <mo>&middot;</mo>
    <msub>
      <mi>I</mi>
      <mi>s</mi>
    </msub>
    <mo>&middot;</mo>
    <mi>B</mi>
  </math>
</div>

<h3>6.2 正向物理仿真（生成仪器电压读数）</h3>
<p>当探头处于不同空间位置 <math xmlns="http://www.w3.org/1998/Math/MathML"><mi>p</mi></math> 时，计算该位置受激发的实际磁感应强度，并叠加了热扰动或仪器测量波动的随机高斯噪声：</p>
<div class="file-loc">代码位置：src/physics/hall_magnetometer/App.tsx -> calculateVH 逻辑块 (第 95 行至第 98 行)</div>
<pre>
// 真实测量环境中引入的随机小幅白噪声干扰，模拟仪器微小抖动
const noise = (activeCoil !== 'none' && Im &gt; 0 && Is &gt; 0) ? (Math.random() - 0.5) * 0.02 : 0;

// 电压计算（乘以 1000 转换为毫伏级展示）
return (SIM_SENSOR_K * Is * fieldTesla + noise) / 1000;
</pre>

<h3>6.3 逆向标定与未知电磁测量（实验教学核心）</h3>
<p>在教学实验中，用户需要根据已知长螺线管中心理论磁场 <math xmlns="http://www.w3.org/1998/Math/MathML"><msub><mi>B</mi><mtext>theory</mtext></msub></math> 和当前读到的电压 <math xmlns="http://www.w3.org/1998/Math/MathML"><msub><mi>V</mi><mi>H</mi></msub></math> ，逆向求出传感器校准灵敏度系数 <math xmlns="http://www.w3.org/1998/Math/MathML"><mi>K</mi></math>，然后再基于此 <math xmlns="http://www.w3.org/1998/Math/MathML"><mi>K</mi></math> 去测量其他任意位置的未知磁场。代码开发时，核心标定与重算函数实现为：</p>
<div class="file-loc">代码位置：src/physics/hall_magnetometer/App.tsx -> handleCalibrateK 函数 (第 106 行至第 109 行)</div>
<pre>
const handleCalibrateK = () => {
    if (!canCalibrate) return;
    // K = |V_H| / (I_s * |B_theory|)
    setCalibratedK(Math.abs(currentVHMv) / (Is * Math.abs(theoryB)));
};
</pre>
<div class="file-loc">代码位置：src/physics/hall_magnetometer/App.tsx -> calculateBFromHall 函数 (第 21 行至第 24 行)</div>
<pre>
function calculateBFromHall({ vhMv, k, Is }: { vhMv: number; k: number | null; Is: number }) {
  if (!k || Is &lt;= 0) return null;
  // B = V_H / (K * I_s)
  return (vhMv / (k * Is)) * 1000; // 返回单位: mT
}
</pre>

<h2>7. 总结</h2>
<p>本项目的电磁仿真引擎并未采取简易查表或静态曲线拟合的方式，而是通过实现基于<b>毕奥-萨伐尔定律的数值积分求和</b>以及<b>欧拉折线场图追踪算法</b>，在前端高度动态地还原了三维电磁场的时空演化。程序将抽象的公式转化为交互式的三维渲染粒子流动和具有实验误差规律的实测仪表盘读数，真正做到了“代码为物理骨架，渲染为物理血肉”。</p>

</body>
